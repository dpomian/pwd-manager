# Flask Configuration
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_very_secret_and_unique_key_here

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_PATH=/path/to/your/passwords.db

# Security Settings
ENCRYPTION_METHOD=fernet

# Phase 1 security feature flags (all default to 0/off for backward compat).
# Enable them one at a time per the rollout plan in security-fix-plan.md.
# CSRF protection for all forms and AJAX calls (C3).
ENABLE_CSRF=0
# Security headers: CSP, X-Frame-Options, HSTS, cookie hardening (M2/M6).
ENABLE_SECURITY_HEADERS=0
# Sanitise markdown output with bleach to prevent stored XSS (C4).
ENABLE_MARKDOWN_SANITIZE=0
# Hide internal exception details from error responses (M1).
HIDE_INTERNAL_ERRORS=0
# Refuse to start if SECRET_KEY is weak/unset (H1). Default: warn only.
STRICT_SECRET_KEY=0

# Docker Configuration
PWD_MANAGER_PORT=5000
PWD_MANAGER_DB_PATH=./instance
